+def review_items(at):
+    return [item for item in at.get_by_key("review")
+            if item.type in {"text_input", "caption", "error", "warning"}]
+
+
+def test_review_groups_customer_fields_and_quantities_with_native_help():
+    at = start_manual(new_app())
+    review = at.get_by_key("review")
+    assert [[field.key for field in column.text_input] for column in review.columns] == [
+        ["edit_customer_name"], ["edit_contact"], ["edit_size_S"],
+        ["edit_size_M"], ["edit_size_L"], ["edit_stated_total"]]
+    assert at.text_input(key="edit_stated_total").label == "Requested total"
+    for key in ("size_S", "size_M", "size_L", "stated_total", "deadline"):
+        assert at.text_input(key=f"edit_{key}").help
+    assert not review.get("metric")
+    assert not review.get("popover")
+    items = review_items(at)
+    for key, message in (("edit_customer_name", "Enter customer name."),
+                         ("edit_contact", "Enter email or phone.")):
+        index = next(i for i, item in enumerate(items) if item.key == key)
+        assert items[index + 1].value == message
+
+
+def test_mismatch_and_deadline_failures_are_adjacent_and_still_block_acknowledgment():
+    at = start_manual(new_app())
+    fill_fields(at, stated_total="30", deadline="September 28")
+    items = review_items(at)
+    total_index = next(i for i, item in enumerate(items) if item.key == "edit_stated_total")
+    assert items[total_index + 1].value == "25 assigned / 30 requested"
+    assert items[total_index + 2].value == "The size counts add up to 25. The request says 30."
+    deadline_index = next(i for i, item in enumerate(items) if item.key == "edit_deadline")
+    assert "not a real date" in items[deadline_index + 1].value
+    at.checkbox(key="reviewed").check().run()
+    assert at.button(key="prepare").disabled
+    assert not at.get("download_button")
+
+
+@pytest.mark.parametrize("changes,summary,error", [
+    ({"size_L": ""}, "Quantities missing: L / 25 requested", "Enter a quantity for L."),
+    ({"size_L": "0", "stated_total": ""}, "20 assigned / Requested total unknown", None),
+    ({"size_M": "no"}, "Assigned total unavailable / 25 requested", "Size M must be a whole number."),
+    ({"stated_total": "no"}, "25 assigned / Requested total invalid", "Requested quantity must be a whole number."),
+    ({"size_S": "-1"}, "Assigned total unavailable / 25 requested", "size counts cannot be negative"),
+])
+def test_quantity_summary_distinguishes_missing_invalid_and_explicit_zero(changes, summary, error):
+    at = start_manual(new_app())
+    fill_fields(at, **changes)
+    items = review_items(at)
+    index = next(i for i, item in enumerate(items) if item.value == summary)
+    if error:
+        assert error in items[index + 1].value
+    assert not any(item.value.startswith('Customer wrote "') for item in at.caption)
+
+
+def test_source_details_keep_exact_original_evidence_and_stale_provenance(monkeypatch):
+    original = proposal(deadline=None, stated_total=30)
+    original["fields"]["deadline"]["evidence"] = "Needed September 28"
+    source = "\n  Original inquiry\nNeeded September 28  \n"
+    at, _ = extract(monkeypatch, original, source=source)
+    details = next(item for item in at.expander if item.label == "View source details")
+    assert not details.proto.expanded
+    assert [item.value for item in details.code] == [source] + [
+        original["fields"][name]["evidence"] for name in model.FIELDS]
+    items = review_items(at)
+    index = next(i for i, item in enumerate(items) if item.key == "edit_deadline")
+    assert items[index + 1].value == 'Customer wrote "Needed September 28"'
+    fill_fields(at)
+    at.text_area(key="source_text").set_value("A different inquiry").run()
+    details = next(item for item in at.expander if item.label == "View source details")
+    assert details.code[0].value == source
+    assert at.session_state.extraction == original
+    assert at.checkbox(key="reviewed").disabled
+
+
+def test_unmapped_validation_messages_are_visible_without_mutating_result(monkeypatch):
+    import order_logic
+    original_validate = order_logic.validate
+    returned = []
+
+    def with_unmapped_messages(*args, **kwargs):
+        result = original_validate(*args, **kwargs)
+        result["blocks"].append("Production approval unavailable.")
+        result["missing"].append("delivery method")
+        result["ok"] = False
+        returned.append((result, deepcopy(result)))
+        return result
+
+    monkeypatch.setattr(order_logic, "validate", with_unmapped_messages)
+    at = start_manual(new_app())
+    fill_fields(at)
+    assert any(item.value == "Production approval unavailable." for item in at.error)
+    assert any(item.value == "Still needed · delivery method" for item in at.warning)
+    assert all(result == saved for result, saved in returned)
+    assert at.button(key="prepare").disabled
